# Скопируй в .env и заполни. .env в git не попадает.

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
# Твой user_id: запусти бота и отправь /id
OWNER_TELEGRAM_ID=
# Локальный Bot API (docker compose поднимает его сам): снимает лимит 20 МБ на файлы.
# Пусто = облачный api.telegram.org. В docker-compose задаётся автоматически.
TELEGRAM_API_BASE=
# Для локального Bot API: https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---------- LLM ----------
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Всё, что начинается с "deepseek", идёт в DeepSeek (без зрения), остальное — в Claude.
# У каждой модели должна быть цена в config/pricing.yaml.
TEXT_MODEL=deepseek-flash
VISION_MODEL=claude-haiku-4-5
# Креативщик, сценарий и озвучка. Пусто = TEXT_MODEL. Слабые идеи - поставь модель сильнее.
CREATIVE_MODEL=

# ---------- Озвучка (ElevenLabs) ----------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_STABILITY=1.0
ELEVENLABS_SIMILARITY=0.75
# Ускорение готовой озвучки (ffmpeg atempo). Сменил голос — перемерь.
TTS_TEMPO=1.0

# ---------- Генерация картинок и видео (fal.ai) ----------
# Поиск в интернете для креативщика (tavily.com). Пусто = без поиска.
TAVILY_API_KEY=

FAL_KEY=
# Ключи из config/video_models.yaml; пусто = default из файла
# Пусто — рабочая модель из config/video_models.yaml (h3-max-turbo, 1080P, $0.08/с).
# Черновой режим для обкатки промптов и сценариев: VIDEO_MODEL=h3-max-turbo-480
#   ($0.025/с, ролик 20 с ≈ $0.67). Флагман: VIDEO_MODEL=h3-max ($0.16/с).
VIDEO_MODEL=
IMAGE_MODEL=

# ---------- Режимы ----------
# 1 = разрешить тесты с платными API (pytest -m live). Никогда в CI.
RUN_LIVE_TESTS=0
